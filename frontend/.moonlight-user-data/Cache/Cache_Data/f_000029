e;\r\n  font-size: 11.5px;\r\n  background: var(--bg-input);\r\n  border: 1px solid var(--border);\r\n  border-radius: 5px;\r\n  padding: 1px 5px;\r\n  color: var(--primary);\r\n}\r\n\r\n.md-pre {\r\n  margin: 8px 0;\r\n  padding: 10px 12px;\r\n  border-radius: 9px;\r\n  background: rgba(16, 14, 32, 0.6);\r\n  border: 1px solid var(--border);\r\n  overflow-x: auto;\r\n  max-height: 260px;\r\n  overflow-y: auto;\r\n}\r\n.md-pre code {\r\n  font-family: ui-monospace, 'JetBrains Mono', Consolas, monospace;\r\n  font-size: 11.5px;\r\n  line-height: 1.6;\r\n  color: var(--text-secondary);\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n\r\n.md-body table {\r\n  margin: 8px 0;\r\n  border-collapse: collapse;\r\n  width: 100%;\r\n  font-size: 12px;\r\n}\r\n.md-body th, .md-body td {\r\n  border: 1px solid var(--border);\r\n  padding: 5px 10px;\r\n  text-align: left;\r\n}\r\n.md-body th {\r\n  background: var(--bg-soft);\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n}\r\n\r\n.md-body hr {\r\n  margin: 10px 0;\r\n  border: none;\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.md-body strong { font-weight: 600; color: var(--text); }\r\n.md-body em { font-style: italic; }\r\n.md-body del { opacity: 0.6; }\r\n\r\n/* M1：输出行内的 Markdown 渲染接管排版（覆盖 pre-wrap / 等宽字体） */\r\n.run-output-line .md-body {\r\n  white-space: normal;\r\n}\r\n.tsc-output-line .md-body {\r\n  white-space: normal;\r\n  font-family: var(--font-family);\r\n}\r\n"
