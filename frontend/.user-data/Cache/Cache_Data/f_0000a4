\n}\n\n.engine-card-btn.active {\n  background: var(--gradient-main);\n  color: var(--primary-ink);\n  border-color: transparent;\n}\n\n.engine-card-reason {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n  color: var(--text-faint);\n  padding: 0 12px 10px 31px;\n}\n\n.engine-reason-dot {\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: var(--warn);\n  flex-shrink: 0;\n}\n\n.engine-card-config {\n  padding: 12px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  background: var(--bg-soft);\n}\n\n.engine-config-actions {\n  display: flex;\n  justify-content: flex-end;\n  margin-top: 2px;\n}\n\n/* ---- VOICEVOX 本地引擎（并入引擎库卡内） ---- */\n\n.voicevox-inline {\n  gap: 10px;\n}\n\n.voicevox-state-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.voicevox-state-text {\n  font-size: 12px;\n  color: var(--text-secondary);\n  line-height: 1.6;\n  flex: 1;\n  min-width: 0;\n}\n\n.voicevox-progress {\n  height: 7px;\n  border-radius: 999px;\n  background: var(--bg-soft);\n  overflow: hidden;\n  border: 1px solid var(--border);\n}\n\n.voicevox-progress-bar {\n  height: 100%;\n  border-radius: 999px;\n  background: var(--gradient-main);\n  transition: width 0.4s ease;\n}\n\n.voicevox-card-actions {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n/* ---- 更多设置（折叠） ---- */\n\n.engine-more-toggle {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  border: none;\n  background: transparent;\n  color: var(--text-faint);\n  font-size: 12px;\n  cursor: pointer;\n  padding: 6px 2px;\n  transition: color 0.15s;\n}\n\n.engine-more-toggle:hover {\n  color: var(--text-secondary);\n}\n\n.engine-more-arrow {\n  display: inline-block;\n  font-size: 10px;\n  transition: transform 0.2s ease;\n}\n\n.engine-more-arrow.open {\n  transform: rotate(90deg);\n}\n\n.engine-more-panel {\n  margin-top: 10px;\n  padding: 14px;\n  border-radius: var(--