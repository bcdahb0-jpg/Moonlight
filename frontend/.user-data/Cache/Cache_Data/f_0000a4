const __vite__css = "/* ==========================================================================\n   Moonlight - global styles (暗夜月光 · 精致玻璃)\n   设计语言：深蓝紫夜空 + 月光金主色 + 毛玻璃分层 + 辉光点缀\n   双主题（dark / light）通过 :root[data-theme] 切换，所有组件共用这套 token。\n   ========================================================================== */\n\n:root {\n  --font-family: 'Microsoft YaHei', 'Segoe UI', 'PingFang SC', 'HarmonyOS Sans SC', sans-serif;\n\n  /* ---- 暗夜月光（默认） ---- */\n  --bg: rgba(16, 14, 32, 0.92);\n  --bg-panel: rgba(24, 21, 48, 0.88);\n  --bg-soft: rgba(255, 255, 255, 0.055);\n  --bg-glass: rgba(30, 26, 60, 0.55);\n  --bg-glass-strong: rgba(36, 31, 70, 0.72);\n  --bg-input: rgba(255, 255, 255, 0.06);\n\n  --text: #ece7fb;\n  --text-secondary: rgba(236, 231, 251, 0.58);\n  --text-faint: rgba(236, 231, 251, 0.36);\n\n  --border: rgba(210, 190, 255, 0.16);\n  --border-strong: rgba(240, 200, 130, 0.45);\n\n  /* 月光金主色 */\n  --primary: #f2c879;\n  --primary-strong: #e8b563;\n  --primary-ink: #3a2c12; /* 主色上的文字（深色） */\n\n  --gradient-main: linear-gradient(135deg, #f2c879 0%, #e8a45f 55%, #d98a4e 100%);\n  --gradient-soft: linear-gradient(\n    135deg,\n    rgba(242, 200, 121, 0.22),\n    rgba(216, 138, 78, 0.14)\n  );\n  --gradient-night: linear-gradient(160deg, #0c0a1f 0%, #171238 55%, #241c4e 100%);\n\n  --message-user-bg: linear-gradient(135deg, rgba(242, 200, 121, 0.4), rgba(216, 138, 78, 0.28));\n  --message-ai-bg: rgba(255, 255, 255, 0.07);\n\n  --glow: rgba(242, 200, 121, 0.28);\n  --glow-strong: rgba(242, 200, 121, 0.45);\n\n  --danger: #f87171;\n  --danger-bg: rgba(248, 113, 113, 0.12);\n  --success: #6ee7a8;\n  --warn: #fbbf24;\n\n  --radius-sm: 8px;\n  --radius-md: 12px;\n  --radius-lg: 16px;\n  --radius-xl: 22px;\n\n  --shadow-1: 0 2px 10px rgba(0, 0, 0, 0.28);\n  --shadow-2: 0 8px 28px rgba(0, 0, 0, 0.35);\n  --shadow-3: 0 16px 48px rgba(0, 0, 0, 0.42);\n\n  --glass-blur: blur(22px) saturate(150%);\n}\n\n/* ---- 月夜浅色（可选亮色模式） ---- */\n:root[data-theme='light'] {\n  --bg: rgba(248, 244, 255, 0.94);\n  --bg-panel: rgba(255, 253, 255, 0.92);\n  --bg-soft: rgba(120, 90, 200, 0.07);\n  --bg-glass: rgba(255, 255, 255, 0.6);\n  --bg-glass-strong: rgba(255, 255, 255, 0.78);\n  --bg-input: rgba(120, 90, 200, 0.06);\n\n  --text: #37294f;\n  --text-secondary: rgba(55, 41, 79, 0.6);\n  --text-faint: rgba(55, 41, 79, 0.38);\n\n  --border: rgba(150, 110, 220, 0.22);\n  --border-strong: rgba(200, 140, 60, 0.5);\n\n  --primary: #c98a2e;\n  --primary-strong: #b5731f;\n  --primary-ink: #fff8ec;\n\n  --gradient-main: linear-gradient(135deg, #f2c879 0%, #e8a45f 60%, #d98a4e 100%);\n  --gradient-soft: linear-gradient(135deg, rgba(242, 200, 121, 0.35), rgba(216, 138, 78, 0.2));\n  --gradient-night: linear-gradient(160deg, #fdf8ff 0%, #f5ecff 55%, #efe4ff 100%);\n\n  --message-user-bg: linear-gradient(135deg, rgba(242, 200, 121, 0.75), rgba(216, 138, 78, 0.55));\n  --message-ai-bg: rgba(120, 90, 200, 0.07);\n\n  --glow: rgba(200, 140, 60, 0.25);\n  --glow-strong: rgba(200, 140, 60, 0.4);\n\n  --danger-bg: #fdeaea;\n}\n\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nhtml,\nbody,\n#root {\n  width: 100%;\n  height: 100%;\n}\n\nbody {\n  font-family: var(--font-family);\n  background: transparent;\n  color: var(--text);\n  overflow: hidden;\n  user-select: none;\n  -webkit-app-region: no-drag;\n  -webkit-font-smoothing: antialiased;\n}\n\nbutton,\ninput,\nselect,\ntextarea {\n  font-family: inherit;\n  font-size: 13px;\n  color: inherit;\n}\n\nbutton {\n  -webkit-tap-highlight-color: transparent;\n}\n\n.app {\n  width: 100%;\n  height: 100%;\n  position: relative;\n  background: transparent;\n}\n\n/* ------------------------------------------------------------------ */\n/* Pet mode: the Live2D canvas fills the transparent window             */\n/* ------------------------------------------------------------------ */\n\n.pet-layout,\n.live2d-root {\n  width: 100%;\n  height: 100%;\n  position: relative;\n}\n\n.live2d-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.pet-loading {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 14px;\n  color: var(--text-secondary);\n  font-size: 13px;\n}\n\n.spinner {\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  border: 3px solid var(--border);\n  border-top-color: var(--primary);\n  animation: spin 0.9s linear infinite;\n  box-shadow: 0 0 18px var(--glow);\n}\n\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* ------------------------------------------------------------------ */\n/* Window mode: conversation sidebar + chat left + Live2D right        */\n/* ------------------------------------------------------------------ */\n\n.window-layout {\n  width: 100%;\n  height: 100%;\n  position: relative;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  background: var(--bg);\n  border-radius: 14px;\n  overflow: hidden;\n  border: 1px solid var(--border);\n  box-shadow: 0 8px 40px var(--glow);\n  backdrop-filter: var(--glass-blur);\n}\n\n/* 标题栏下方的三栏内容区（会话侧栏 / 聊天 / Live2D） */\n.window-body {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr) minmax(220px, 0.42fr);\n  grid-template-rows: minmax(0, 1fr);\n  min-height: 0;\n}\n\n/* ------------------------------------------------------------------ */\n/* 窗口模式自定义标题栏（参考 Codex 桌面端：左 logo + 名称，右窗口控制）  */\n/* ------------------------------------------------------------------ */\n\n.window-titlebar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 40px;\n  padding: 0 8px 0 14px;\n  flex-shrink: 0;\n  background: var(--bg-glass-strong);\n  border-bottom: 1px solid var(--border);\n  -webkit-app-region: drag;\n  user-select: none;\n}\n\n.window-titlebar-brand {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n}\n\n.window-titlebar-left {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-width: 0;\n}\n\n/* 操作入口：切换模式 / 设置 / 穿透 / 打断（左上角，logo 右侧） */\n.window-titlebar-actions {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  -webkit-app-region: no-drag;\n}\n\n.titlebar-action {\n  width: 28px;\n  height: 28px;\n  border: none;\n  border-radius: 7px;\n  background: transparent;\n  color: var(--text-secondary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: background 0.14s ease, color 0.14s ease;\n}\n\n.titlebar-action:hover {\n  background: var(--bg-soft);\n  color: var(--primary);\n}\n\n.titlebar-action:active {\n  background: var(--border);\n}\n\n.window-titlebar-logo {\n  width: 20px;\n  height: 20px;\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 6px;\n  background: var(--gradient-main);\n  color: rgba(255, 255, 255, 0.92);\n  box-shadow: 0 1px 5px var(--glow);\n}\n\n.window-titlebar-name {\n  font-size: 13px;\n  font-weight: 500;\n  letter-spacing: 0.2px;\n  color: var(--text);\n  white-space: nowrap;\n}\n\n.window-titlebar-controls {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  -webkit-app-region: no-drag;\n}\n\n.win-control {\n  width: 38px;\n  height: 28px;\n  border: none;\n  border-radius: 7px;\n  background: transparent;\n  color: var(--text-secondary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: background 0.14s ease, color 0.14s ease;\n}\n\n.win-control:hover {\n  background: var(--bg-soft);\n  color: var(--text);\n}\n\n.win-control:active {\n  background: var(--border);\n}\n\n.win-control-close:hover {\n  background: #e81123;\n  color: #ffffff;\n}\n\n.win-control-close:active {\n  background: #c50f1f;\n  color: #ffffff;\n}\n\n/* 最大化时去掉圆角与边框，铺满工作区 */\n.app-maximized .window-layout {\n  border-radius: 0;\n  border: none;\n  box-shadow: none;\n}\n\n/* 会话侧边栏（可折叠，232px 展开 / 收起） */\n.conv-sidebar-wrap {\n  grid-column: 1;\n  position: relative;\n  min-width: 0;\n}\n\n.conv-sidebar {\n  width: 232px;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  background: var(--bg-glass-strong);\n  backdrop-filter: var(--glass-blur);\n  border-right: 1px solid var(--border);\n  overflow: hidden;\n  transition: width 0.26s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;\n}\n\n.conv-sidebar-wrap.closed .conv-sidebar {\n  width: 0;\n  opacity: 0;\n}\n\n.conv-sidebar-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 11px 10px 10px 14px;\n  border-bottom: 1px solid var(--border);\n  flex-shrink: 0;\n}\n\n.conv-sidebar-title {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-secondary);\n  letter-spacing: 0.3px;\n  white-space: nowrap;\n}\n\n.conv-sidebar-actions {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.conv-icon-btn {\n  width: 27px;\n  height: 27px;\n  border-radius: 9px;\n  border: 1px solid transparent;\n  background: transparent;\n  cursor: pointer;\n  color: var(--text-secondary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.16s;\n  flex-shrink: 0;\n}\n\n.conv-icon-btn:hover {\n  color: var(--primary);\n  background: var(--bg-soft);\n  border-color: var(--border);\n}\n\n.conv-sidebar-list {\n  flex: 1;\n  min-height: 0;\n  overflow-y: auto;\n  padding: 8px;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.conv-sidebar-empty {\n  color: var(--text-faint);\n  font-size: 12px;\n  text-align: center;\n  padding: 28px 0;\n  white-space: nowrap;\n}\n\n.conv-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 7px 10px;\n  border-radius: 10px;\n  cursor: pointer;\n  color: var(--text-secondary);\n  transition: background 0.15s, color 0.15s;\n}\n\n.conv-item:hover {\n  background: var(--bg-soft);\n  color: var(--text);\n}\n\n.conv-item.active {\n  background: var(--gradient-soft);\n  color: var(--primary);\n  box-shadow: inset 2.5px 0 0 var(--primary);\n}\n\n.conv-item-title {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 12.5px;\n}\n\n.conv-item-del {\n  width: 22px;\n  height: 22px;\n  border-radius: 7px;\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  color: var(--text-faint);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  transition: opacity 0.15s, color 0.15s, background 0.15s;\n  flex-shrink: 0;\n}\n\n.conv-item:hover .conv-item-del,\n.conv-item-del:focus-visible {\n  opacity: 1;\n}\n\n.conv-item-del:hover {\n  color: var(--danger);\n  background: var(--danger-bg);\n}\n\n/* 重命名：hover 编辑按钮 + 行内输入框 */\n.conv-item-edit {\n  width: 22px;\n  height: 22px;\n  border-radius: 7px;\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  color: var(--text-faint);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  transition: opacity 0.15s, color 0.15s, background 0.15s;\n  flex-shrink: 0;\n}\n\n.conv-item:hover .conv-item-edit,\n.conv-item-edit:focus-visible {\n  opacity: 1;\n}\n\n.conv-item-edit:hover {\n  color: var(--primary);\n  background: var(--bg-soft);\n}\n\n.conv-item-editing {\n  cursor: text;\n  background: var(--bg-input);\n  box-shadow: inset 0 0 0 1px var(--border-strong);\n}\n\n.conv-item-edit-input {\n  flex: 1;\n  min-width: 0;\n  height: 24px;\n  border: none;\n  outline: none;\n  background: transparent;\n  font-size: 12.5px;\n  color: var(--text);\n  padding: 0 2px;\n}\n\n.conv-item-edit-input::placeholder {\n  color: var(--text-faint);\n}\n\n/* 收起后的悬浮展开按钮（左上角） */\n.conv-rail {\n  position: absolute;\n  top: 12px;\n  left: 12px;\n  z-index: 30;\n  width: 32px;\n  height: 32px;\n  border-radius: 10px;\n  border: 1px solid var(--border);\n  background: var(--bg-glass-strong);\n  backdrop-filter: var(--glass-blur);\n  box-shadow: var(--shadow-1);\n  color: var(--text-secondary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.16s;\n}\n\n.conv-rail:hover {\n  color: var(--primary);\n  border-color: var(--border-strong);\n  transform: scale(1.07);\n  box-shadow: 0 0 14px var(--glow);\n}\n\n/* 角色框：Live2D 画布 + 底部角色状态条（好感/心情/连接状态） */\n.char-col {\n  grid-column: 3;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  border-left: 1px solid var(--border);\n  background: radial-gradient(\n    circle at 50% 28%,\n    rgba(242, 200, 121, 0.16),\n    rgba(120, 90, 220, 0.1) 45%,\n    transparent 72%\n  );\n}\n\n.char-col .live2d-root {\n  flex: 1;\n  min-height: 0;\n}\n\n.char-status-bar {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 6px;\n  padding: 9px 10px 11px;\n  flex-shrink: 0;\n  border-top: 1px solid var(--border);\n  background: var(--bg-glass);\n  backdrop-filter: var(--glass-blur);\n}\n\n.window-layout .chat-panel {\n  grid-column: 2;\n  min-width: 0;\n  background: linear-gradient(\n    180deg,\n    var(--bg-glass-strong) 0%,\n    var(--bg-glass) 100%\n  );\n}\n\n/* ------------------------------------------------------------------ */\n/* Chat panel                                                          */\n/* ------------------------------------------------------------------ */\n\n.chat-panel {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  min-height: 0;\n  min-width: 0;\n}\n\n.message-list {\n  flex: 1;\n  overflow-y: auto;\n  padding: 14px 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.chat-empty {\n  margin: auto;\n  color: var(--text-faint);\n  font-size: 13px;\n  letter-spacing: 0.3px;\n}\n\n.chat-bubble-row {\n  display: flex;\n  gap: 8px;\n  align-items: flex-start;\n  animation: bubble-in 0.22s ease-out;\n}\n\n@keyframes bubble-in {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.chat-bubble-row.user {\n  justify-content: flex-end;\n}\n\n.chat-avatar {\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 15px;\n  flex-shrink: 0;\n  background: var(--gradient-soft);\n  border: 1px solid var(--border);\n  overflow: hidden;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\n}\n\n.chat-avatar-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.chat-bubble {\n  max-width: 76%;\n  padding: 9px 13px;\n  border-radius: 15px;\n  font-size: 13px;\n  line-height: 1.55;\n  word-break: break-word;\n  white-space: pre-wrap;\n}\n\n.chat-bubble.user {\n  background: var(--message-user-bg);\n  color: #2b2210;\n  border-top-right-radius: 5px;\n  box-shadow: 0 2px 10px rgba(216, 138, 78, 0.18);\n}\n\n:root[data-theme='light'] .chat-bubble.user {\n  color: #fff;\n}\n\n.chat-bubble.ai {\n  background: var(--message-ai-bg);\n  border: 1px solid var(--border);\n  border-top-left-radius: 5px;\n  backdrop-filter: blur(8px);\n}\n\n.chat-bubble-name {\n  font-size: 11px;\n  color: var(--primary);\n  font-weight: 600;\n  margin-bottom: 3px;\n}\n\n.chat-bubble-text {\n  position: relative;\n}\n\n.chat-caret {\n  display: inline-block;\n  width: 2px;\n  height: 1em;\n  background: var(--primary);\n  margin-left: 2px;\n  vertical-align: text-bottom;\n  animation: blink 0.8s steps(1) infinite;\n  border-radius: 1px;\n}\n\n@keyframes blink {\n  50% {\n    opacity: 0;\n  }\n}\n\n.chat-thinking {\n  display: flex;\n  gap: 5px;\n  padding: 6px 4px;\n}\n\n.chat-thinking .dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--primary);\n  animation: bounce 1s infinite;\n}\n\n.chat-thinking .dot:nth-child(2) {\n  animation-delay: 0.15s;\n}\n.chat-thinking .dot:nth-child(3) {\n  animation-delay: 0.3s;\n}\n\n@keyframes bounce {\n  0%,\n  100% {\n    transform: translateY(0);\n    opacity: 0.4;\n  }\n  50% {\n    transform: translateY(-4px);\n    opacity: 1;\n  }\n}\n\n/* ------------------------------------------------------------------ */\n/* 聊天输入条：输入框 + 动作组（会话管理已移至左侧侧边栏）             */\n/* ------------------------------------------------------------------ */\n.chat-input-bar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 12px;\n  border-top: 1px solid var(--border);\n  background: var(--bg-glass);\n  backdrop-filter: var(--glass-blur);\n}\n\n/* 输入框 */\n.chat-input {\n  flex: 1;\n  min-width: 0;\n  height: 34px;\n  padding: 7px 15px;\n  border-radius: 17px;\n  border: 1px solid var(--border);\n  background: var(--bg-input);\n  outline: none;\n  transition: border-color 0.18s, box-shadow 0.18s, background 0.18s;\n}\n\n.chat-input::placeholder {\n  color: var(--text-faint);\n}\n\n.chat-input:focus {\n  border-color: var(--border-strong);\n  background: var(--bg-soft);\n  box-shadow: 0 0 0 3px var(--glow), inset 0 1px 2px rgba(0, 0, 0, 0.16);\n}\n\n.chat-input:disabled {\n  opacity: 0.55;\n}\n\n/* 右侧动作组 */\n.chat-actions {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-shrink: 0;\n}\n\n.chat-btn {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  border: 1px solid var(--border);\n  background: transparent;\n  cursor: pointer;\n  color: var(--text-secondary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.16s;\n  flex-shrink: 0;\n}\n\n.chat-btn:hover:not(:disabled) {\n  color: var(--primary);\n  border-color: var(--border-strong);\n  background: var(--bg-soft);\n  transform: scale(1.07);\n  box-shadow: 0 0 12px var(--glow);\n}\n\n.chat-btn:active:not(:disabled) {\n  transform: scale(0.93);\n}\n\n.chat-btn:disabled {\n  opacity: 0.4;\n  cursor: default;\n}\n\n/* 发送：金色主按钮（有文字才点亮） */\n.chat-btn.send {\n  width: 34px;\n  height: 34px;\n  background: var(--gradient-main);\n  border: none;\n  color: var(--primary-ink);\n  box-shadow: 0 2px 12px rgba(242, 180, 100, 0.35);\n}\n\n.chat-btn.send:hover:not(:disabled) {\n  color: var(--primary-ink);\n  background: var(--gradient-main);\n  transform: scale(1.07);\n  box-shadow: 0 4px 18px var(--glow-strong);\n}\n\n.chat-btn.send:disabled {\n  opacity: 0.42;\n  filter: saturate(0.55);\n  box-shadow: none;\n}\n\n/* 发送按钮临时态：AI 回复输出中变打断按钮（红色警示） */\n.chat-btn.send.interrupt {\n  background: var(--danger);\n  color: #fff;\n  box-shadow: 0 2px 12px rgba(248, 113, 113, 0.4);\n}\n\n.chat-btn.send.interrupt:hover:not(:disabled) {\n  color: #fff;\n  background: var(--danger);\n  transform: scale(1.07);\n  box-shadow: 0 4px 18px rgba(248, 113, 113, 0.55);\n}\n\n.chat-btn.mic.recording {\n  background: var(--danger);\n  border-color: var(--danger);\n  color: #fff;\n  animation: pulse 1.2s infinite;\n}\n\n@keyframes pulse {\n  50% {\n    box-shadow: 0 0 0 6px rgba(248, 113, 113, 0.22);\n  }\n}\n\n/* ------------------------------------------------------------------ */\n/* Pet overlay controls                                                 */\n/* ------------------------------------------------------------------ */\n\n.pet-overlay {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 8px;\n  border-radius: 999px;\n  background: var(--bg-glass);\n  border: 1px solid var(--border);\n  backdrop-filter: var(--glass-blur);\n  box-shadow: var(--shadow-1);\n  opacity: 0.35;\n  transition: opacity 0.25s;\n  z-index: 20;\n}\n\n.pet-overlay:hover {\n  opacity: 1;\n}\n\n/* 信息区（好感/心情/连接点）常驻显示；操作按钮（模式/设置/穿透/打断）默认隐藏，hover 展开 */\n.pet-overlay .overlay-btn {\n  width: 0;\n  height: 27px;\n  padding: 0;\n  border: none;\n  border-radius: 50%;\n  background: transparent;\n  cursor: pointer;\n  color: var(--text-secondary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  pointer-events: none;\n  transform: scale(0.5);\n  transition: width 0.2s ease, opacity 0.2s ease, transform 0.2s ease, background 0.15s, color 0.15s;\n  margin: 0;\n  overflow: hidden;\n  flex-shrink: 0;\n}\n\n.pet-overlay:hover .overlay-btn,\n.pet-overlay:focus-within .overlay-btn {\n  width: 27px;\n  padding: 0;\n  opacity: 1;\n  pointer-events: auto;\n  transform: scale(1);\n}\n\n.overlay-btn:hover {\n  background: var(--bg-soft);\n  color: var(--primary);\n  transform: scale(1.08);\n}\n\n/* 「⋯」更多菜单 */\n.overlay-menu {\n  position: relative;\n}\n\n.overlay-menu-dropdown {\n  position: absolute;\n  top: 34px;\n  right: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  min-width: 170px;\n  padding: 7px;\n  border-radius: 13px;\n  background: var(--bg-glass-strong);\n  border: 1px solid var(--border);\n  backdrop-filter: var(--glass-blur);\n  box-shadow: var(--shadow-2);\n  z-index: 30;\n  animation: menu-in 0.16s ease-out;\n}\n\n@keyframes menu-in {\n  from {\n    opacity: 0;\n    transform: translateY(-4px) scale(0.98);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n.overlay-menu-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 10px;\n  border: none;\n  border-radius: 9px;\n  background: transparent;\n  color: var(--text);\n  font-size: 12.5px;\n  text-align: left;\n  cursor: pointer;\n  transition: background 0.12s;\n}\n\n.overlay-menu-item:hover {\n  background: var(--bg-soft);\n}\n\n.overlay-menu-item.active {\n  color: var(--primary);\n}\n\n.conn-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: var(--text-faint);\n  flex-shrink: 0;\n  box-shadow: 0 0 6px currentColor;\n}\n\n.conn-dot[data-status='connected'] {\n  background: var(--success);\n  color: var(--success);\n}\n\n.conn-dot[data-status='connecting'] {\n  background: var(--primary);\n  color: var(--primary);\n  animation: pulse 1.2s infinite;\n}\n\n.conn-dot[data-status='disconnected'] {\n  background: var(--danger);\n  color: var(--danger);\n}\n\n.emotion-badge {\n  font-size: 11px;\n  padding: 4px 10px;\n  border-radius: 999px;\n  background: var(--gradient-soft);\n  border: 1px solid var(--border);\n  color: var(--text);\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n}\n\n.affection-badge {\n  font-size: 11px;\n  padding: 4px 10px;\n  border-radius: 999px;\n  background: linear-gradient(135deg, rgba(255, 154, 158, 0.35), rgba(250, 208, 196, 0.3));\n  border: 1px solid rgba(255, 140, 140, 0.45);\n  color: var(--text);\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n}\n\n/* ------------------------------------------------------------------ */\n/* Settings 通用原子组件（设置面板 / Dashboard 共用）                    */\n/* ------------------------------------------------------------------ */\n\n.settings-section {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n.settings-section h3 {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--primary);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding-bottom: 8px;\n  border-bottom: 1px solid var(--border);\n  letter-spacing: 0.3px;\n}\n\n.settings-section h3::before {\n  content: '';\n  width: 4px;\n  height: 14px;\n  border-radius: 2px;\n  background: var(--gradient-main);\n  box-shadow: 0 0 8px var(--glow);\n  flex-shrink: 0;\n}\n\n/* 字段 */\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.field > span {\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n.field input,\n.field select,\n.field textarea {\n  padding: 9px 12px;\n  border-radius: 11px;\n  border: 1px solid var(--border);\n  background: var(--bg-input);\n  outline: none;\n  transition: border-color 0.16s, box-shadow 0.16s, background 0.16s;\n}\n\n.field select {\n  appearance: none;\n  background-image: linear-gradient(45deg, transparent 50%, var(--text-secondary) 50%),\n    linear-gradient(135deg, var(--text-secondary) 50%, transparent 50%);\n  background-position: calc(100% - 18px) 55%, calc(100% - 13px) 55%;\n  background-size: 5px 5px;\n  background-repeat: no-repeat;\n  padding-right: 30px;\n}\n\n.field textarea {\n  resize: vertical;\n  line-height: 1.6;\n}\n\n.field input:focus,\n.field select:focus,\n.field textarea:focus {\n  border-color: var(--border-strong);\n  box-shadow: 0 0 0 3px var(--glow);\n  background: var(--bg-glass);\n}\n\n.field input:disabled,\n.field select:disabled,\n.field textarea:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n\n.field input[type='range'] {\n  padding: 0;\n  border: none;\n  background: transparent;\n  accent-color: var(--primary);\n  height: 22px;\n}\n\n.field input[type='number'] {\n  max-width: 220px;\n}\n\n/* 行内开关（自定义 Switch，替代原生 checkbox 视觉） */\n.switch-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  position: relative;\n  cursor: pointer;\n  padding: 10px 14px;\n  border-radius: 12px;\n  border: 1px solid var(--border);\n  background: var(--bg-glass);\n  transition: border-color 0.16s;\n}\n\n.switch-row:hover {\n  border-color: var(--border-strong);\n}\n\n.switch-label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  color: var(--text);\n}\n\n.switch-label svg {\n  color: var(--primary);\n  flex-shrink: 0;\n}\n\n.switch-row input.switch {\n  position: absolute;\n  opacity: 0;\n  width: 0;\n  height: 0;\n}\n\n.switch-ui {\n  width: 38px;\n  height: 22px;\n  border-radius: 999px;\n  background: var(--bg-soft);\n  border: 1px solid var(--border);\n  position: relative;\n  flex-shrink: 0;\n  transition: background 0.2s, border-color 0.2s;\n}\n\n.switch-ui::after {\n  content: '';\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: var(--text-secondary);\n  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s;\n}\n\n.switch-row input.switch:checked + .switch-ui {\n  background: var(--gradient-main);\n  border-color: transparent;\n  box-shadow: 0 0 10px var(--glow);\n}\n\n.switch-row input.switch:checked + .switch-ui::after {\n  transform: translateX(16px);\n  background: #fff;\n}\n\n/* 兼容旧代码里的原生 checkbox（.toggle-row input[type=checkbox]）也套用 Switch 外观 */\n.toggle-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  font-size: 13px;\n  gap: 10px;\n  padding: 9px 12px;\n  border-radius: 11px;\n  border: 1px solid var(--border);\n  background: var(--bg-glass);\n}\n\n.toggle-row input[type='checkbox'] {\n  appearance: none;\n  width: 38px;\n  height: 22px;\n  border-radius: 999px;\n  background: var(--bg-soft);\n  border: 1px solid var(--border);\n  position: relative;\n  cursor: pointer;\n  flex-shrink: 0;\n  transition: background 0.2s, border-color 0.2s;\n}\n\n.toggle-row input[type='checkbox']::after {\n  content: '';\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: var(--text-secondary);\n  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s;\n}\n\n.toggle-row input[type='checkbox']:checked {\n  background: var(--gradient-main);\n  border-color: transparent;\n}\n\n.toggle-row input[type='checkbox']:checked::after {\n  transform: translateX(16px);\n  background: #fff;\n}\n\n/* 按钮 */\n.btn-row {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  flex-wrap: wrap;\n}\n\n.btn {\n  padding: 8px 16px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: var(--bg-glass);\n  cursor: pointer;\n  font-size: 12.5px;\n  color: var(--text);\n  transition: all 0.15s;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.btn:hover:not(:disabled) {\n  transform: translateY(-1px);\n  border-color: var(--border-strong);\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);\n  color: var(--primary);\n}\n\n.btn:active:not(:disabled) {\n  transform: translateY(0) scale(0.98);\n}\n\n.btn:disabled {\n  opacity: 0.45;\n  cursor: default;\n}\n\n.btn-primary {\n  background: var(--gradient-main);\n  border-color: transparent;\n  color: var(--primary-ink);\n  font-weight: 600;\n  box-shadow: 0 4px 14px var(--glow);\n}\n\n.btn-primary:hover:not(:disabled) {\n  color: var(--primary-ink);\n  filter: brightness(1.06);\n  box-shadow: 0 6px 20px var(--glow-strong);\n}\n\n.btn-danger {\n  background: var(--danger-bg) !important;\n  color: var(--danger) !important;\n  border-color: rgba(220, 80, 80, 0.45) !important;\n}\n\n.btn-sm {\n  padding: 5px 12px;\n  font-size: 12px;\n}\n\n.btn-ghost {\n  background: transparent;\n  color: inherit;\n  border-color: currentColor;\n}\n\n.setting-status {\n  font-size: 12px;\n  padding: 9px 12px;\n  border-radius: 10px;\n  background: var(--bg-glass);\n  border: 1px solid var(--border);\n  color: var(--text-secondary);\n  line-height: 1.6;\n}\n\n.setting-note {\n  font-size: 12px;\n  padding: 9px 12px;\n  border-radius: 10px;\n  background: rgba(251, 191, 36, 0.1);\n  border: 1px solid rgba(251, 191, 36, 0.3);\n  color: var(--text-secondary);\n  line-height: 1.6;\n}\n\n.voice-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.voice-row select {\n  flex: 1;\n  min-width: 0;\n}\n\n/* 列表 */\n.list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  max-height: 180px;\n  overflow-y: auto;\n  padding-right: 2px;\n}\n\n.list-item {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  text-align: left;\n  padding: 8px 12px;\n  border-radius: 10px;\n  border: 1px solid var(--border);\n  background: var(--bg-glass);\n  cursor: pointer;\n  position: relative;\n  transition: border-color 0.15s;\n}\n\n.list-item:hover {\n  border-color: var(--border-strong);\n}\n\n.list-item.active {\n  background: var(--gradient-soft);\n  border-color: var(--border-strong);\n}\n\n.list-item-title {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.list-item-sub {\n  font-size: 11px;\n  color: var(--text-secondary);\n}\n\n.list-item-badge {\n  display: inline-block;\n  margin-left: 6px;\n  padding: 1px 8px;\n  border-radius: 999px;\n  font-size: 10px;\n  background: var(--gradient-main);\n  color: var(--primary-ink);\n  vertical-align: middle;\n}\n\n.list-item-del {\n  position: absolute;\n  top: 7px;\n  right: 7px;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  border: 1px solid var(--border);\n  background: transparent;\n  color: var(--text-secondary);\n  font-size: 10px;\n  cursor: pointer;\n  line-height: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.12s;\n}\n\n.list-item-del:hover {\n  background: var(--danger-bg);\n  color: var(--danger);\n}\n\n.field-select-inline {\n  max-width: 180px;\n  padding: 7px;\n  border-radius: 9px;\n  border: 1px solid var(--border);\n  background: var(--bg-input);\n}\n\n/* 话题 chips */\n.topic-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.topic-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 5px 12px;\n  border-radius: 999px;\n  background: var(--gradient-soft);\n  border: 1px solid var(--border);\n  font-size: 12px;\n  transition: border-color 0.15s;\n}\n\n.topic-chip:hover {\n  border-color: var(--border-strong);\n}\n\n.topic-chip button {\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  color: var(--text-secondary);\n  font-size: 11px;\n  display: flex;\n  align-items: center;\n  padding: 0;\n  transition: color 0.12s;\n}\n\n.topic-chip button:hover {\n  color: var(--danger);\n}\n\n.topic-input {\n  flex: 1;\n  min-width: 140px;\n  padding: 8px 13px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: var(--bg-input);\n  outline: none;\n  transition: border-color 0.16s, box-shadow 0.16s;\n}\n\n.topic-input:focus {\n  border-color: var(--border-strong);\n  box-shadow: 0 0 0 3px var(--glow);\n}\n\n.suggestions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.chip-btn {\n  padding: 5px 12px;\n  border-radius: 999px;\n  border: 1px dashed var(--border);\n  background: transparent;\n  cursor: pointer;\n  font-size: 11.5px;\n  color: var(--text-secondary);\n  transition: all 0.14s;\n}\n\n.chip-btn:hover {\n  color: var(--primary);\n  border-color: var(--border-strong);\n  background: var(--bg-soft);\n}\n\n.chip-btn.active {\n  background: var(--gradient-soft);\n  border-style: solid;\n  border-color: var(--border-strong);\n  color: var(--text);\n}\n\n/* 屏幕感知信息 */\n.screen-info {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  font-size: 12px;\n  padding: 10px 13px;\n  border-radius: 11px;\n  background: var(--bg-glass);\n  border: 1px solid var(--border);\n}\n\n.screen-label {\n  color: var(--text-secondary);\n  margin-right: 8px;\n}\n\n.screen-value {\n  color: var(--text);\n}\n\n/* Scrollbars */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--border);\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--primary);\n}\n\n/* ==========================================================================\n   Configuration dashboard (window-mode full settings UI)\n   ========================================================================== */\n\n.dashboard {\n  position: absolute;\n  inset: 0;\n  z-index: 50;\n  display: flex;\n  flex-direction: column;\n  background: var(--gradient-night);\n  backdrop-filter: var(--glass-blur);\n  color: var(--text);\n}\n\n/* 玻璃头部 */\n.dashboard-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  height: 54px;\n  padding: 0 16px;\n  border-bottom: 1px solid var(--border);\n  background: var(--bg-glass-strong);\n  backdrop-filter: var(--glass-blur);\n  flex-shrink: 0;\n  -webkit-app-region: drag;\n}\n\n.dashboard-brand {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-right: auto;\n}\n\n.dashboard-brand-mark {\n  width: 30px;\n  height: 30px;\n  border-radius: 10px;\n  background: var(--gradient-main);\n  color: var(--primary-ink);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 0 16px var(--glow);\n}\n\n.dashboard-brand-name {\n  font-size: 15px;\n  font-weight: 700;\n  letter-spacing: 0.4px;\n  background: linear-gradient(90deg, #f5d98c, #e8a45f);\n  -webkit-background-clip: text;\n  background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.dashboard-brand-sub {\n  font-size: 11px;\n  color: var(--text-faint);\n  padding-left: 10px;\n  border-left: 1px solid var(--border);\n}\n\n.dashboard-header-status {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  color: var(--text-secondary);\n  padding: 5px 12px;\n  border-radius: 999px;\n  background: var(--bg-soft);\n  border: 1px solid var(--border);\n  -webkit-app-region: no-drag;\n}\n\n.dashboard-close {\n  width: 30px;\n  height: 30px;\n  border-radius: 10px;\n  border: 1px solid var(--border);\n  background: transparent;\n  color: var(--text-secondary);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.15s;\n  -webkit-app-region: no-drag;\n}\n\n.dashboard-close:hover {\n  background: var(--danger-bg);\n  color: var(--danger);\n  border-color: rgba(220, 80, 80, 0.45);\n}\n\n.dashboard-body {\n  flex: 1;\n  display: flex;\n  overflow: hidden;\n}\n\n/* 侧边栏（扁平分组） */\n.dashboard-sidebar {\n  width: 236px;\n  flex-shrink: 0;\n  border-right: 1px solid var(--border);\n  overflow-y: auto;\n  padding: 14px 10px 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  background: var(--bg-glass);\n  backdrop-filter: var(--glass-blur);\n}\n\n.dashboard-group {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.dashboard-group-head {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  padding: 6px 10px 4px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  color: var(--primary);\n}\n\n.dashboard-group-head svg {\n  opacity: 0.9;\n}\n\n.dashboard-group-desc {\n  padding: 0 10px 6px;\n  font-size: 10.5px;\n  color: var(--text-faint);\n  line-height: 1.5;\n}\n\n.dashboard-nav-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 11px;\n  border-radius: 11px;\n  cursor: pointer;\n  font-size: 13px;\n  color: var(--text-secondary);\n  border: 1px solid transparent;\n  background: transparent;\n  text-align: left;\n  width: 100%;\n  transition: all 0.16s;\n  position: relative;\n}\n\n.dashboard-nav-item:hover {\n  background: var(--bg-soft);\n  color: var(--text);\n}\n\n.dashboard-nav-item.active {\n  background: var(--gradient-soft);\n  border-color: var(--border-strong);\n  color: var(--text);\n}\n\n.dashboard-nav-item.active::before {\n  content: '';\n  position: absolute;\n  left: -10px;\n  top: 20%;\n  bottom: 20%;\n  width: 3px;\n  border-radius: 3px;\n  background: var(--gradient-main);\n  box-shadow: 0 0 10px var(--glow);\n}\n\n.dashboard-nav-icon {\n  width: 22px;\n  height: 22px;\n  border-radius: 7px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  color: var(--text-secondary);\n  transition: all 0.16s;\n}\n\n.dashboard-nav-item.active .dashboard-nav-icon {\n  background: var(--gradient-main);\n  color: var(--primary-ink);\n  box-shadow: 0 0 12px var(--glow);\n}\n\n.dashboard-nav-label {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.dashboard-nav-badge {\n  margin-left: auto;\n  font-size: 10px;\n  padding: 2px 8px;\n  border-radius: 999px;\n  background: var(--gradient-main);\n  color: var(--primary-ink);\n}\n\n/* 开发者模式开关（底部） */\n.dashboard-dev-toggle {\n  margin-top: auto;\n  padding: 10px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.dashboard-dev-toggle .switch-row {\n  background: transparent;\n  border: none;\n  padding: 2px 0;\n}\n\n.dashboard-dev-hint {\n  font-size: 10.5px;\n  color: var(--text-faint);\n  padding-left: 2px;\n}\n\n/* 内容区 */\n.dashboard-content {\n  flex: 1;\n  overflow-y: auto;\n  padding: 22px 26px 34px;\n  background: radial-gradient(\n      circle at 85% 8%,\n      rgba(242, 200, 121, 0.1),\n      transparent 42%\n    ),\n    radial-gradient(circle at 12% 90%, rgba(140, 100, 255, 0.08), transparent 45%);\n}\n\n.dashboard-section-head {\n  max-width: 720px;\n  margin-bottom: 20px;\n}\n\n.dashboard-section-head h2 {\n  font-size: 22px;\n  font-weight: 700;\n  letter-spacing: 0.4px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.dashboard-section-head p {\n  margin-top: 6px;\n  font-size: 12.5px;\n  color: var(--text-secondary);\n}\n\n.dashboard-section {\n  max-width: 720px;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n.dashboard-section > h3 {\n  font-size: 14px;\n  color: var(--primary);\n  padding-bottom: 8px;\n  border-bottom: 1px solid var(--border);\n}\n\n/* 内容区块统一玻璃卡片化：每个设置分区包一层 */\n.dashboard-section .settings-section {\n  padding: 20px 22px;\n  border-radius: var(--radius-lg);\n  background: var(--bg-glass);\n  border: 1px solid var(--border);\n  backdrop-filter: var(--glass-blur);\n  box-shadow: var(--shadow-1);\n}\n\n/* System info cards */\n.system-card {\n  padding: 13px 15px;\n  border-radius: 12px;\n  border: 1px solid var(--border);\n  background: var(--bg-glass);\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  transition: border-color 0.15s;\n}\n\n.system-card:hover {\n  border-color: var(--border-strong);\n}\n\n.system-card-title {\n  font-size: 11px;\n  color: var(--text-secondary);\n  letter-spacing: 0.2px;\n}\n\n.system-card-value {\n  font-size: 13px;\n  font-weight: 500;\n  word-break: break-word;\n}\n\n.system-card-error {\n  border-color: rgba(220, 80, 80, 0.5) !important;\n  background: var(--danger-bg);\n}\n\n/* Theme toggle (radio pills) */\n.theme-toggle-row {\n  display: flex;\n  gap: 6px;\n}\n\n.theme-toggle-btn {\n  padding: 7px 18px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: var(--bg-glass);\n  color: var(--text-secondary);\n  cursor: pointer;\n  font-size: 12.5px;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  transition: all 0.15s;\n}\n\n.theme-toggle-btn:hover {\n  color: var(--text);\n  border-color: var(--border-strong);\n}\n\n.theme-toggle-btn.active {\n  background: var(--gradient-main);\n  border-color: transparent;\n  color: var(--primary-ink);\n  font-weight: 600;\n  box-shadow: 0 3px 12px var(--glow);\n}\n\n/* Emotion debug */\n.emotion-badge.large {\n  font-size: 16px;\n  padding: 10px 20px;\n}\n\n.emotion-bar {\n  height: 6px;\n  border-radius: 3px;\n  background: var(--bg-soft);\n  overflow: hidden;\n  margin-top: 4px;\n  flex: 1;\n}\n\n.emotion-bar-fill {\n  height: 100%;\n  border-radius: 3px;\n  background: var(--gradient-main);\n  transition: width 0.3s;\n}\n\n.emotion-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n/* Range controls */\n.range-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.range-row input[type='range'] {\n  flex: 1;\n  accent-color: var(--primary);\n}\n\n.range-val {\n  font-size: 12px;\n  color: var(--text-secondary);\n  min-width: 36px;\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n}\n\n/* Live2D model grid */\n.model-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\n  gap: 10px;\n}\n\n.model-card {\n  padding: 10px;\n  border-radius: 13px;\n  border: 1px solid var(--border);\n  background: var(--bg-glass);\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  cursor: pointer;\n  transition: all 0.16s;\n}\n\n.model-card:hover {\n  transform: translateY(-2px);\n  border-color: var(--border-strong);\n  box-shadow: var(--shadow-1);\n}\n\n.model-card-avatar {\n  width: 100%;\n  aspect-ratio: 1;\n  overflow: hidden;\n  border-radius: 9px;\n  background: var(--bg);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 28px;\n}\n\n.model-card-avatar img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.model-card-name {\n  font-size: 12px;\n  font-weight: 500;\n}\n\n.model-card-path {\n  font-size: 10px;\n  color: var(--text-secondary);\n  word-break: break-all;\n}\n\n.model-card.active {\n  border-color: var(--border-strong);\n  box-shadow: 0 0 0 1px var(--border-strong), 0 0 16px var(--glow);\n}\n\n.model-picker {\n  margin-top: 4px;\n}\n\n.model-picker-label {\n  font-size: 11px;\n  color: var(--text-secondary);\n  margin-bottom: 6px;\n}\n\n.model-card-gen {\n  padding: 5px 8px;\n  border: none;\n  border-radius: 8px;\n  background: var(--bg-soft);\n  color: var(--text);\n  font-size: 11px;\n  cursor: pointer;\n  transition: all 0.12s;\n}\n\n.model-card-gen:hover {\n  background: var(--gradient-main);\n  color: var(--primary-ink);\n}\n\n.model-card-gen:disabled {\n  opacity: 0.6;\n  cursor: default;\n}\n\n/* 角色卡画廊 */\n.character-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));\n  gap: 12px;\n  margin-bottom: 14px;\n}\n\n.character-card {\n  position: relative;\n  padding: 9px;\n  border-radius: 14px;\n  border: 1px solid var(--border);\n  background: var(--bg-glass);\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  cursor: pointer;\n  transition: all 0.16s;\n  backdrop-filter: var(--glass-blur);\n}\n\n.character-card:hover {\n  transform: translateY(-3px);\n  border-color: var(--border-strong);\n  box-shadow: var(--shadow-2);\n}\n\n.character-card.active {\n  border-color: var(--border-strong);\n  box-shadow: 0 0 0 1px var(--border-strong), 0 0 18px var(--glow);\n}\n\n.character-card.current .character-card-avatar {\n  outline: 2px solid var(--primary);\n  outline-offset: -1px;\n  box-shadow: 0 0 14px var(--glow);\n}\n\n.character-card-avatar {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 1;\n  overflow: hidden;\n  border-radius: 10px;\n  background: var(--bg);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 30px;\n}\n\n.character-card-avatar img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.character-card-badge {\n  position: absolute;\n  top: 5px;\n  left: 5px;\n  font-size: 10px;\n  padding: 2px 8px;\n  border-radius: 999px;\n  background: var(--gradient-main);\n  color: var(--primary-ink);\n  font-weight: 600;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);\n}\n\n.character-card-name {\n  font-size: 12.5px;\n  font-weight: 500;\n  text-align: center;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* 角色卡「启用 / 重新加载」按钮（立即生效入口） */\n.character-card-enable {\n  padding: 5px 0;\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  background: var(--gradient-soft);\n  color: var(--primary);\n  font-size: 11.5px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.14s;\n  text-align: center;\n  font-family: inherit;\n}\n\n.character-card-enable:hover {\n  background: var(--gradient-main);\n  color: var(--primary-ink);\n  border-color: transparent;\n  box-shadow: 0 0 10px var(--glow);\n}\n\n.character-card-enable.current {\n  background: transparent;\n  color: var(--text-secondary);\n  font-weight: 500;\n}\n\n.character-card-enable.current:hover {\n  background: var(--bg-soft);\n  color: var(--primary);\n}\n\n.character-card-del {\n  position: absolute;\n  top: 5px;\n  right: 5px;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  border: none;\n  background: rgba(0, 0, 0, 0.45);\n  color: #fff;\n  font-size: 10px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.12s;\n}\n\n.character-card-del:hover {\n  background: var(--danger);\n}\n\n/* 新建角色卡 */\n.character-card-new {\n  border: 1.5px dashed var(--border);\n  background: var(--bg-glass);\n  color: var(--text-secondary);\n  justify-content: center;\n  align-items: center;\n}\n\n.character-card-new:hover {\n  border-color: var(--border-strong);\n  color: var(--primary);\n  background: var(--gradient-soft);\n}\n\n.character-card-new .character-card-avatar {\n  background: transparent;\n}\n\n.character-card-plus {\n  font-size: 34px;\n  line-height: 1;\n}\n\n/* Restart notice */\n.restart-notice {\n  font-size: 11px;\n  color: var(--text-secondary);\n  padding: 8px 12px;\n  border-radius: 9px;\n  background: var(--bg-glass);\n  border: 1px dashed var(--border);\n  line-height: 1.7;\n}\n\n/* ------------------------------------------------------------------ */\n/* Onboarding 向导 + 错误修复卡                                        */\n/* ------------------------------------------------------------------ */\n\n.onboarding {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--gradient-night);\n  color: #f5f3ff;\n  padding: 24px;\n}\n\n.onboarding-card {\n  width: 100%;\n  max-width: 660px;\n  background: var(--bg-glass-strong);\n  backdrop-filter: blur(24px) saturate(160%);\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 22px;\n  padding: 30px 34px 26px;\n  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45), 0 0 60px rgba(242, 200, 121, 0.08);\n}\n\n.onboarding-steps {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 24px;\n}\n\n.onboarding-step {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n  opacity: 0.4;\n  transition: opacity 0.25s;\n}\n\n.onboarding-step.on {\n  opacity: 1;\n}\n\n.onboarding-dot {\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 13px;\n  font-weight: 600;\n  background: rgba(255, 255, 255, 0.1);\n  border: 1px solid rgba(255, 255, 255, 0.25);\n  transition: all 0.2s;\n}\n\n.onboarding-step.on .onboarding-dot {\n  background: var(--gradient-main);\n  border-color: transparent;\n  color: var(--primary-ink);\n  box-shadow: 0 0 16px var(--glow);\n}\n\n.onboarding-label {\n  font-size: 12px;\n  letter-spacing: 0.5px;\n}\n\n.onboarding-body {\n  min-height: 320px;\n}\n\n.onboarding-pane h2 {\n  font-size: 22px;\n  margin: 0 0 10px;\n  color: #fff;\n}\n\n.onboarding-desc {\n  font-size: 14px;\n  color: rgba(245, 243, 255, 0.75);\n  line-height: 1.7;\n  margin: 0 0 18px;\n}\n\n.onboarding-conn {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 14px;\n  padding: 14px 16px;\n  border-radius: 12px;\n  background: rgba(255, 255, 255, 0.07);\n}\n\n.onboarding-checks {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.ob-check-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 14px;\n  border-radius: 10px;\n  background: rgba(255, 255, 255, 0.06);\n  font-size: 13px;\n  border: 1px solid transparent;\n}\n\n.ob-check-row.ok {\n  background: rgba(110, 231, 168, 0.12);\n  border-color: rgba(110, 231, 168, 0.3);\n}\n\n.ob-check-row.warn {\n  background: rgba(251, 191, 36, 0.12);\n  border-color: rgba(251, 191, 36, 0.3);\n}\n\n.ob-check-ico {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n  font-weight: 700;\n  flex-shrink: 0;\n}\n\n.ob-check-row.ok .ob-check-ico {\n  background: #2eaa7d;\n  color: #fff;\n}\n\n.ob-check-row.warn .ob-check-ico {\n  background: #c07a1f;\n  color: #fff;\n}\n\n.ob-check-label {\n  font-weight: 600;\n  width: 96px;\n  flex-shrink: 0;\n}\n\n.ob-check-hint {\n  color: rgba(245, 243, 255, 0.72);\n}\n\n.ob-checking {\n  font-size: 13px;\n  color: rgba(245, 243, 255, 0.6);\n  padding: 6px 0;\n}\n\n.onboarding-tip {\n  margin-top: 14px;\n  padding: 10px 14px;\n  border-radius: 10px;\n  background: rgba(242, 200, 121, 0.12);\n  border: 1px solid rgba(242, 200, 121, 0.35);\n  font-size: 13px;\n}\n\n.onboarding-llm-status {\n  margin-bottom: 14px;\n  padding: 10px 14px;\n  border-radius: 10px;\n  background: rgba(251, 191, 36, 0.14);\n  font-size: 13px;\n}\n\n.onboarding-llm-status.ok {\n  background: rgba(110, 231, 168, 0.14);\n}\n\n.on