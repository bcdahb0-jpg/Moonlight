y:hover:not(:disabled) {\n  filter: brightness(1.08);\n}\n\n.onboarding .settings-section {\n  background: rgba(255, 255, 255, 0.07);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  border-radius: 14px;\n  padding: 16px 18px;\n  margin-top: 8px;\n  color: #f5f3ff;\n}\n\n.onboarding .settings-section h3 {\n  color: #f2c879;\n  border-bottom-color: rgba(255, 255, 255, 0.15);\n}\n\n.onboarding .field input,\n.onboarding .field select,\n.onboarding .field textarea {\n  background: rgba(255, 255, 255, 0.08);\n  border-color: rgba(255, 255, 255, 0.2);\n  color: #f5f3ff;\n}\n\n.onboarding .field select option {\n  background: #2a2452;\n  color: #f5f3ff;\n}\n\n/* ErrorBanner（错误修复卡） */\n.error-banner {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n  margin: 8px 12px;\n  padding: 12px 14px;\n  border-radius: 12px;\n  background: var(--danger-bg);\n  border: 1px solid rgba(220, 80, 80, 0.4);\n  font-size: 13px;\n  backdrop-filter: var(--glass-blur);\n}\n\n.error-banner-title {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-weight: 600;\n  color: var(--danger);\n}\n\n.error-banner-code {\n  font-size: 10px;\n  font-family: Consolas, monospace;\n  padding: 1px 8px;\n  border-radius: 6px;\n  background: rgba(220, 80, 80, 0.12);\n  color: var(--danger);\n  flex-shrink: 0;\n}\n\n.error-banner-fix {\n  margin-top: 4px;\n  color: var(--text-secondary);\n  line-height: 1.6;\n}\n\n.error-banner-actions {\n  display: flex;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n/* 过渡动画（页面/卡片出现） */\n@keyframes fade-up {\n  from {\n    opacity: 0;\n    transform: translateY(8px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.dashboard-section-head,\n.dashboard-section > * {\n  animation: fade-up 0.28s ease-out both;\n}\n\n/* ------------------------------------------------------------------ */\n/* ASR/TTS 引擎设置（UI v2：分段 Tab + 当前引擎面板 + 引擎库卡片）        */\n/* ------------------------------------------------------------------ */\n\n.engine-settings-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 14px;\n  flex-wrap: wrap;\n}\n\n.engine-tabs {\n  display: inline-flex;\n  padding: 3px;\n  border-radius: 999px;\n  background: var(--bg-soft);\n  border: 1px solid var(--border);\n}\n\n.engine-tab {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  padding: 6px 18px;\n  border: none;\n  border-radius: 999px;\n  background: transparent;\n  color: var(--text-secondary);\n  font-size: 13px;\n  cursor: pointer;\n  transition: all 0.18s ease;\n}\n\n.engine-tab:hover {\n  color: var(--text);\n}\n\n.engine-tab.active {\n  background: var(--gradient-main);\n  color: var(--primary-ink);\n  font-weight: 500;\n  box-shadow: 0 2px 10px var(--glow);\n}\n\n.engine-tab-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  flex-shrink: 0;\n  background: currentColor;\n}\n\n.engine-settings-sub {\n  font-size: 12px;\n  color: var(--text-faint);\n}\n\n/* ---- 当前引擎面板 ---- */\n\n.engine-current {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 14px 16px;\n  border-radius: var(--radius-lg);\n  background: var(--bg-glass-strong);\n  border: 1px solid var(--border);\n  margin-bottom: 18px;\n  flex-wrap: wrap;\n}\n\n.engine-current.ready {\n  border-color: rgba(110, 231, 168, 0.35);\n  box-shadow: 0 0 0 1px rgba(110, 231, 168, 0.12), 0 6px 24px rgba(0, 0, 0, 0.18);\n}\n\n.engine-current-main {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-width: 0;\n}\n\n.engine-current-info {\n  min-width: 0;\n}\n\n.engine-current-name {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 15px;\n  font-weight: 500;\n  color: var(--text);\n}\n\n.engine-current-desc {\n  font-size: 12px;\n  color: var(--text-secondary);\n  margin-top: 3px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  max-width: 380px;\n}\n\n.engine-current-switch {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n.engine-current-switch span {\n  font-size: 12px;\n  color: var(--text-faint);\n}\n\n/* 切换引擎下拉：不在 .field 内，需显式主题化（否则暗色下原生白底/深字看不见） */\n.engine-current-switch select {\n  min-width: 200px;\n  padding: 8px 30px 8px 12px;\n  border-radius: 10px;\n  border: 1px solid var(--border);\n  background-color: var(--bg-input);\n  background-image: linear-gradient(45deg, transparent 50%, var(--text-secondary) 50%),\n    linear-gradient(135deg, var(--text-secondary) 50%, transparent 50%);\n  background-position: calc(100% - 18px) 55%, calc(100% - 13px) 55%;\n  background-size: 5px 5px;\n  background-repeat: no-repeat;\n  color: var(--text);\n  appearance: none;\n  outline: none;\n  cursor: pointer;\n  transition: border-color 0.16s, box-shadow 0.16s, background 0.16s;\n}\n\n.engine-current-switch select:hover {\n  border-color: var(--border-strong);\n}\n\n.engine-current-switch select:focus {\n  border-color: var(--border-strong);\n  box-shadow: 0 0 0 3px var(--glow);\n}\n\n/* 全局兜底：所有 select 的展开面板都跟随主题（暗色下防原生白底） */\nselect option {\n  background-color: var(--bg-panel);\n  color: var(--text);\n}\n\n/* ---- 状态点（呼吸动画） ---- */\n\n.engine-status-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.engine-status-dot.on {\n  background: var(--success);\n  box-shadow: 0 0 8px rgba(110, 231, 168, 0.6);\n  animation: engine-pulse 2.2s ease-in-out infinite;\n}\n\n.engine-status-dot.off {\n  background: var(--text-faint);\n}\n\n@keyframes engine-pulse {\n  0%,\n  100% {\n    box-shadow: 0 0 4px rgba(110, 231, 168, 0.35);\n  }\n  50% {\n    box-shadow: 0 0 10px rgba(110, 231, 168, 0.75);\n  }\n}\n\n/* ---- 引擎库 ---- */\n\n.engine-section-label {\n  display: flex;\n  align-items: baseline;\n  gap: 10px;\n  margin: 4px 2px 10px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-secondary);\n}\n\n.engine-section-count {\n  font-size: 11px;\n  font-weight: 400