{
  "name": "moonlight-frontend",
  "version": "1.0.0",
  "description": "Moonlight - AI desktop pet (Electron + React + Live2D) frontend for Open-LLM-VTuber backend",
  "main": "dist-electron/main.js",
  "author": "Moonlight",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@soullink-emotion/engine": "^0.1.0-beta.1",
    "@soullink-emotion/profile-generator": "^0.1.0-beta.1",
    "active-win": "^8.2.1",
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "active-win"
    ]
  }
}
